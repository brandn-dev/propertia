generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserCapability {
  VIEW_DASHBOARD
  MANAGE_PROPERTIES
  MANAGE_TENANTS
  MANAGE_PEOPLE
  MANAGE_CONTRACTS
  MANAGE_BILLING
  MANAGE_INVOICE_TEMPLATES
  MANAGE_CHARGES
  MANAGE_BACKLOG
  MANAGE_COSA
  MANAGE_UTILITIES
  MANAGE_METERS
  RECORD_READINGS
}

enum PropertyOwnershipType {
  OWNED
  LEASED
}

enum PropertyCategory {
  BUILDING
  UNIT
  LAND
  COMMERCIAL_SPACE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  ARCHIVED
}

enum InvoiceTitleScale {
  COMPACT
  STANDARD
  PROMINENT
}

enum TenantType {
  INDIVIDUAL
  BUSINESS
}

enum TenantStatus {
  ACTIVE
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum InvoiceOrigin {
  GENERATED
  BACKLOG
}

enum InvoiceDateDisplayMode {
  SHOW
  HIDE
}

enum InvoiceItemDescriptionMode {
  AUTO
  SHOW
  HIDE
  CUSTOM
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  REVERSED
}

enum InvoiceItemType {
  RENT
  RECURRING_CHARGE
  UTILITY_READING
  COSA
  ADJUSTMENT
  ARREARS
}

enum InvoiceAdjustmentType {
  ADDITION
  DEDUCTION
}

enum InvoiceAdjustmentValueType {
  FIXED
  PERCENTAGE
}

enum InvoiceAdjustmentSource {
  MANUAL
  SYSTEM
  BACKLOG
}

enum CosaCalculationMode {
  METER_READING
  DAILY_RATE
  MANUAL_TOTAL
}

enum DeferredInvoiceBalanceStatus {
  OPEN
  APPLIED
  CANCELLED
}

enum RecurringChargeType {
  INTERNET
  PARKING
  ASSOCIATION_DUES
  MAINTENANCE
  OTHER
}

enum UtilityType {
  ELECTRICITY
  WATER
  GAS
  SEWER
  OTHER
}

enum MeterReadingOrigin {
  OPERATIONAL
  BACKLOG
}

enum AllocationType {
  PERCENTAGE
  PER_UNIT
  EQUAL_SPLIT
  BY_AREA
  CUSTOM
}

enum IncreaseType {
  FIXED
  PERCENTAGE
}

enum RentCalculationType {
  SIMPLE
  COMPOUND
}

enum RentBasedOn {
  BASE_RENT
  PREVIOUS_RENT
}

enum AdvanceRentApplication {
  FIRST_BILLABLE_CYCLES
  LAST_BILLABLE_CYCLES
  SPLIT_FIRST_AND_LAST_CYCLES
}

enum NotificationKind {
  INVOICE_DUE_SOON
  INVOICE_OVERDUE
  CONTRACT_EXPIRING
  SHARED_READING_READY
  METER_READING_MISSING
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  displayName        String
  passwordHash       String
  passwordSalt       String
  role               UserRole
  capabilities       UserCapability[]
  avatarUrl          String?
  avatarStorageKey   String?
  isActive           Boolean             @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  meterReadings      MeterReading[]
  notifications      Notification[]
  invoiceAdjustments InvoiceAdjustment[]
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  kind       NotificationKind
  severity   NotificationSeverity @default(INFO)
  dedupeKey  String
  title      String
  message    String
  href       String?
  sourceType String?
  sourceId   String?
  readAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([kind, sourceId])
}

model Property {
  id                        String                   @id @default(cuid())
  name                      String
  propertyCode              String                   @unique
  ownershipType             PropertyOwnershipType
  category                  PropertyCategory
  location                  String
  size                      Decimal?                 @db.Decimal(12, 2)
  isLeasable                Boolean                  @default(false)
  parentPropertyId          String?
  invoiceBrandingTemplateId String?
  status                    PropertyStatus           @default(ACTIVE)
  description               String?
  logoUrl                   String?
  logoStorageKey            String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  parent                    Property?                @relation("PropertyHierarchy", fields: [parentPropertyId], references: [id])
  children                  Property[]               @relation("PropertyHierarchy")
  invoiceBrandingTemplate   InvoiceBrandingTemplate? @relation(fields: [invoiceBrandingTemplateId], references: [id])
  leases                    Lease[]
  contracts                 Contract[]
  utilityMeters             UtilityMeter[]
  cosas                     COSA[]
  cosaTemplates             CosaTemplate[]
  deductions                Deduction[]
  deductionAllocations      DeductionAllocation[]

  @@index([parentPropertyId])
  @@index([invoiceBrandingTemplateId])
  @@index([status])
}

model InvoiceBrandingTemplate {
  id                       String            @id @default(cuid())
  name                     String
  brandName                String
  brandSubtitle            String
  fontFamily               String            @default("Inter")
  showBrandName            Boolean           @default(true)
  showBrandSubtitle        Boolean           @default(true)
  invoiceTitlePrefix       String            @default("Invoice for")
  logoUrl                  String?
  logoStorageKey           String?
  usePropertyLogo          Boolean           @default(true)
  titleScale               InvoiceTitleScale @default(STANDARD)
  logoScalePercent         Int               @default(100)
  brandNameSizePercent     Int               @default(100)
  brandSubtitleSizePercent Int               @default(100)
  tenantNameSizePercent    Int               @default(100)
  titleSizePercent         Int               @default(100)
  brandNameWeight          Int               @default(600)
  tenantNameWeight         Int               @default(700)
  titleWeight              Int               @default(700)
  accentColor              String            @default("#0284c7")
  labelColor               String            @default("#6f82a3")
  valueColor               String            @default("#081225")
  mutedColor               String            @default("#53657f")
  panelBackground          String            @default("#f8fbff")
  isDefault                Boolean           @default(false)
  properties               Property[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([isDefault])
}

model Lease {
  id              String   @id @default(cuid())
  propertyId      String
  lessorName      String
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Decimal  @db.Decimal(12, 2)
  contractFileUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Tenant {
  id                                   String                   @id @default(cuid())
  type                                 TenantType
  status                               TenantStatus             @default(ACTIVE)
  firstName                            String?
  lastName                             String?
  businessName                         String
  contactNumber                        String?
  email                                String?
  address                              String?
  validIdType                          String?
  validIdNumber                        String?
  invoiceDescriptionDateDisplayDefault InvoiceDateDisplayMode   @default(SHOW)
  archivedAt                           DateTime?
  createdAt                            DateTime                 @default(now())
  updatedAt                            DateTime                 @updatedAt
  contracts                            Contract[]
  invoices                             Invoice[]
  deferredInvoiceBalances              DeferredInvoiceBalance[]
  utilityMeters                        UtilityMeter[]
  meterReadings                        MeterReading[]
  representatives                      TenantRepresentative[]
  tenantPeople                         TenantPerson[]

  @@index([status, createdAt])
}

model TenantRepresentative {
  id            String   @id @default(cuid())
  tenantId      String
  firstName     String
  lastName      String
  positionTitle String?
  contactNumber String?
  email         String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Person {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  middleName    String?
  contactNumber String?
  email         String?
  address       String?
  validIdType   String?
  validIdNumber String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenantLinks   TenantPerson[]
}

model TenantPerson {
  id            String   @id @default(cuid())
  tenantId      String
  personId      String
  positionTitle String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personId])
  @@index([tenantId])
  @@index([personId])
}

model Contract {
  id                      String                    @id @default(cuid())
  propertyId              String
  tenantId                String
  startDate               DateTime
  endDate                 DateTime
  monthlyRent             Decimal                   @db.Decimal(12, 2)
  securityDepositMonths   Int                       @default(0)
  advanceRentMonths       Int                       @default(0)
  freeRentCycles          Int                       @default(0)
  advanceRentApplication  AdvanceRentApplication    @default(FIRST_BILLABLE_CYCLES)
  advanceRentFirstMonths  Int                       @default(0)
  advanceRentLastMonths   Int                       @default(0)
  advanceRent             Decimal                   @default(0) @db.Decimal(12, 2)
  securityDeposit         Decimal                   @default(0) @db.Decimal(12, 2)
  paymentStartDate        DateTime
  status                  ContractStatus            @default(DRAFT)
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  property                Property                  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rentAdjustments         RentAdjustment[]
  recurringCharges        ContractRecurringCharge[]
  cosaAllocations         COSAAllocation[]
  cosaTemplateAllocations CosaTemplateAllocation[]
  invoices                Invoice[]
  payments                Payment[]
  deferredInvoiceBalances DeferredInvoiceBalance[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([status, paymentStartDate])
  @@index([tenantId, status, paymentStartDate])
  @@index([status, endDate])
}

model ContractRecurringCharge {
  id                             String                  @id @default(cuid())
  contractId                     String
  chargeType                     RecurringChargeType
  label                          String
  amount                         Decimal                 @db.Decimal(12, 2)
  descriptionDateDisplayOverride InvoiceDateDisplayMode?
  effectiveStartDate             DateTime
  effectiveEndDate               DateTime?
  isActive                       Boolean                 @default(true)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  contract                       Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceItems                   InvoiceItem[]

  @@index([contractId, isActive])
  @@index([effectiveStartDate, effectiveEndDate])
}

model RentAdjustment {
  id              String              @id @default(cuid())
  contractId      String
  effectiveDate   DateTime
  increaseType    IncreaseType
  increaseValue   Decimal             @db.Decimal(12, 2)
  calculationType RentCalculationType
  basedOn         RentBasedOn
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  contract        Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, effectiveDate])
}

model Invoice {
  id                       String                   @id @default(cuid())
  invoiceNumber            String                   @unique
  contractId               String
  tenantId                 String
  publicAccessCode         String?
  issueDate                DateTime
  dueDate                  DateTime
  billingPeriodStart       DateTime
  billingPeriodEnd         DateTime
  subtotal                 Decimal                  @default(0) @db.Decimal(12, 2)
  additionalCharges        Decimal                  @default(0) @db.Decimal(12, 2)
  discount                 Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount              Decimal                  @default(0) @db.Decimal(12, 2)
  balanceDue               Decimal                  @default(0) @db.Decimal(12, 2)
  origin                   InvoiceOrigin            @default(GENERATED)
  status                   InvoiceStatus            @default(DRAFT)
  notes                    String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  contract                 Contract                 @relation(fields: [contractId], references: [id], onDelete: Restrict)
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items                    InvoiceItem[]
  payments                 Payment[]
  sourcedDeferredBalances  DeferredInvoiceBalance[] @relation("DeferredBalanceSourceInvoice")
  resolvedDeferredBalances DeferredInvoiceBalance[] @relation("DeferredBalanceResolvedInvoice")
  adjustments              InvoiceAdjustment[]

  @@unique([contractId, billingPeriodStart, billingPeriodEnd])
  @@index([contractId])
  @@index([tenantId])
  @@index([status, dueDate])
  @@index([tenantId, status, dueDate])
  @@index([dueDate, issueDate])
}

model InvoiceItem {
  id                        String                     @id @default(cuid())
  invoiceId                 String
  itemType                  InvoiceItemType            @default(RENT)
  description               String
  descriptionMode           InvoiceItemDescriptionMode @default(AUTO)
  customDescription         String?
  quantity                  Decimal                    @default(1) @db.Decimal(12, 2)
  unitPrice                 Decimal                    @default(0) @db.Decimal(12, 2)
  amount                    Decimal                    @default(0) @db.Decimal(12, 2)
  contractRecurringChargeId String?
  meterReadingId            String?                    @unique
  cosaAllocationId          String?                    @unique
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  invoice                   Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractRecurringCharge   ContractRecurringCharge?   @relation(fields: [contractRecurringChargeId], references: [id], onDelete: SetNull)
  meterReading              MeterReading?              @relation(fields: [meterReadingId], references: [id], onDelete: SetNull)
  cosaAllocation            COSAAllocation?            @relation(fields: [cosaAllocationId], references: [id], onDelete: SetNull)
  allocations               PaymentAllocation[]
  sourcedDeferredBalances   DeferredInvoiceBalance[]   @relation("DeferredBalanceSourceItem")
  resolvedDeferredBalance   DeferredInvoiceBalance?    @relation("DeferredBalanceResolvedItem")
  adjustmentRecord          InvoiceAdjustment?         @relation("AdjustmentItem")
  targetedAdjustments       InvoiceAdjustment[]        @relation("AdjustmentTargetItem")

  @@index([invoiceId])
  @@index([contractRecurringChargeId])
  @@index([cosaAllocationId])
}

model InvoiceAdjustment {
  id                      String                     @id @default(cuid())
  invoiceId               String
  adjustmentInvoiceItemId String                     @unique
  targetInvoiceItemId     String?
  adjustmentType          InvoiceAdjustmentType
  valueType               InvoiceAdjustmentValueType
  enteredValue            Decimal                    @db.Decimal(12, 2)
  calculatedAmount        Decimal                    @db.Decimal(12, 2)
  label                   String
  source                  InvoiceAdjustmentSource    @default(MANUAL)
  createdById             String?
  createdAt               DateTime                   @default(now())
  invoice                 Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  adjustmentInvoiceItem   InvoiceItem                @relation("AdjustmentItem", fields: [adjustmentInvoiceItemId], references: [id], onDelete: Cascade)
  targetInvoiceItem       InvoiceItem?               @relation("AdjustmentTargetItem", fields: [targetInvoiceItemId], references: [id], onDelete: SetNull)
  createdBy               User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@index([targetInvoiceItemId])
  @@index([adjustmentType, createdAt])
  @@index([createdById])
}

model DeferredInvoiceBalance {
  id                    String                       @id @default(cuid())
  contractId            String
  tenantId              String
  sourceInvoiceId       String
  sourceInvoiceItemId   String
  resolvedInvoiceId     String?
  resolvedInvoiceItemId String?                      @unique
  sourceDescription     String
  sourceItemType        InvoiceItemType
  originalAmount        Decimal                      @db.Decimal(12, 2)
  deferredAmount        Decimal                      @db.Decimal(12, 2)
  status                DeferredInvoiceBalanceStatus @default(OPEN)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  contract              Contract                     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  tenant                Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceInvoice         Invoice                      @relation("DeferredBalanceSourceInvoice", fields: [sourceInvoiceId], references: [id], onDelete: Cascade)
  sourceInvoiceItem     InvoiceItem                  @relation("DeferredBalanceSourceItem", fields: [sourceInvoiceItemId], references: [id], onDelete: Cascade)
  resolvedInvoice       Invoice?                     @relation("DeferredBalanceResolvedInvoice", fields: [resolvedInvoiceId], references: [id], onDelete: SetNull)
  resolvedInvoiceItem   InvoiceItem?                 @relation("DeferredBalanceResolvedItem", fields: [resolvedInvoiceItemId], references: [id], onDelete: SetNull)

  @@index([contractId, status])
  @@index([tenantId, status])
  @@index([sourceInvoiceId])
  @@index([sourceInvoiceItemId])
  @@index([resolvedInvoiceId])
}

model Payment {
  id              String              @id @default(cuid())
  invoiceId       String
  contractId      String
  amountPaid      Decimal             @default(0) @db.Decimal(12, 2)
  dueDate         DateTime
  paymentDate     DateTime?
  status          PaymentStatus       @default(PENDING)
  referenceNumber String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  invoice         Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  contract        Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]

  @@index([invoiceId])
  @@index([contractId])
  @@index([status])
}

model PaymentAllocation {
  id              String      @id @default(cuid())
  paymentId       String
  invoiceItemId   String
  amountAllocated Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  payment         Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceItem     InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceItemId])
  @@index([invoiceItemId])
}

model UtilityMeter {
  id                String         @id @default(cuid())
  propertyId        String
  tenantId          String?
  utilityType       UtilityType
  meterCode         String         @unique
  isShared          Boolean        @default(false)
  openedAt          DateTime       @default(now())
  retiredAt         DateTime?
  openingReading    Decimal        @default(0) @db.Decimal(12, 2)
  replacesMeterId   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  property          Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  replacesMeter     UtilityMeter?  @relation("UtilityMeterReplacementChain", fields: [replacesMeterId], references: [id], onDelete: SetNull)
  replacementMeters UtilityMeter[] @relation("UtilityMeterReplacementChain")
  readings          MeterReading[]
  cosas             COSA[]
  cosaTemplates     CosaTemplate[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([retiredAt])
  @@index([replacesMeterId])
  @@index([isShared, createdAt])
  @@index([propertyId, tenantId, isShared])
}

model MeterReading {
  id              String             @id @default(cuid())
  meterId         String
  tenantId        String?
  readingDate     DateTime
  previousReading Decimal            @db.Decimal(12, 2)
  currentReading  Decimal            @db.Decimal(12, 2)
  consumption     Decimal            @db.Decimal(12, 2)
  ratePerUnit     Decimal            @db.Decimal(12, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  origin          MeterReadingOrigin @default(OPERATIONAL)
  recordedById    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  meter           UtilityMeter       @relation(fields: [meterId], references: [id], onDelete: Cascade)
  tenant          Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  recordedBy      User?              @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  invoiceItem     InvoiceItem?
  cosa            COSA?

  @@unique([meterId, readingDate])
  @@index([readingDate])
  @@index([tenantId])
  @@index([readingDate, createdAt])
  @@index([meterId, readingDate, createdAt])
}

model COSA {
  id              String              @id @default(cuid())
  propertyId      String
  meterId         String?
  meterReadingId  String?             @unique
  description     String
  allocationType  AllocationType
  totalAmount     Decimal             @db.Decimal(12, 2)
  billingDate     DateTime
  calculationMode CosaCalculationMode @default(MANUAL_TOTAL)
  quantity        Decimal?            @db.Decimal(12, 2)
  unitRate        Decimal?            @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  meter           UtilityMeter?       @relation(fields: [meterId], references: [id], onDelete: SetNull)
  meterReading    MeterReading?       @relation(fields: [meterReadingId], references: [id], onDelete: SetNull)
  allocations     COSAAllocation[]

  @@index([propertyId, billingDate])
}

model CosaTemplate {
  id              String                   @id @default(cuid())
  propertyId      String
  meterId         String?
  name            String
  allocationType  AllocationType
  defaultAmount   Decimal?                 @db.Decimal(12, 2)
  calculationMode CosaCalculationMode      @default(MANUAL_TOTAL)
  dailyRate       Decimal?                 @db.Decimal(12, 2)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  property        Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  meter           UtilityMeter?            @relation(fields: [meterId], references: [id], onDelete: SetNull)
  allocations     CosaTemplateAllocation[]

  @@index([propertyId, isActive])
}

model CosaTemplateAllocation {
  id             String       @id @default(cuid())
  cosaTemplateId String
  contractId     String?
  helperLabel    String?
  percentage     Decimal?     @db.Decimal(5, 2)
  unitCount      Int?
  amount         Decimal?     @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cosaTemplate   CosaTemplate @relation(fields: [cosaTemplateId], references: [id], onDelete: Cascade)
  contract       Contract?    @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([cosaTemplateId, contractId])
  @@index([contractId])
}

model COSAAllocation {
  id             String       @id @default(cuid())
  cosaId         String
  contractId     String?
  helperLabel    String?
  percentage     Decimal      @db.Decimal(5, 2)
  unitCount      Int?
  computedAmount Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cosa           COSA         @relation(fields: [cosaId], references: [id], onDelete: Cascade)
  contract       Contract?    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceItem    InvoiceItem?

  @@unique([cosaId, contractId])
  @@index([contractId])
}

model Deduction {
  id             String                @id @default(cuid())
  propertyId     String
  description    String
  totalAmount    Decimal               @db.Decimal(12, 2)
  billingDate    DateTime
  allocationType AllocationType
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  property       Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  allocations    DeductionAllocation[]

  @@index([propertyId, billingDate])
}

model DeductionAllocation {
  id             String    @id @default(cuid())
  deductionId    String
  propertyId     String
  percentage     Decimal   @db.Decimal(5, 2)
  computedAmount Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deduction      Deduction @relation(fields: [deductionId], references: [id], onDelete: Cascade)
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([deductionId, propertyId])
  @@index([propertyId])
}
